@baseUrl = http://localhost:3000
@renderUrl = https://syed-israr-hussain-lab4.onrender.com

### 1. Root API Status
GET {{baseUrl}}/
Accept: application/json

### 2. Register New User (201)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "israr_hussain",
  "name": "Syed Israr Hussain",
  "password": "securePassword123"
}

### 3. Register Duplicate Username (400)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "israr_hussain",
  "name": "Syed Israr Hussain",
  "password": "securePassword123"
}

### 4. Login with Correct Credentials (200)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "israr_hussain",
  "password": "securePassword123"
}

### 5. Login with Unknown Username (400)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "unknown_user",
  "password": "securePassword123"
}

### 6. Login with Wrong Password (400)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "israr_hussain",
  "password": "wrongPassword123"
}

### 7. Missing Fields Test (400)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "missing_pass",
  "name": "Missing Password"
}

### 8. Render Production Verification
GET {{renderUrl}}/
Accept: application/json

### 9. Edge Case: Missing Username on Login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "password": "somePassword"
}
### 10. Edge Case: Missing Password on Login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "israr_hussain"
}
### 11. Edge Case: Empty Body on Login
POST {{baseUrl}}/login
Content-Type: application/json

{}
### 12. Edge Case: Empty Body on Register
POST {{baseUrl}}/register
Content-Type: application/json

{}
### 13. Production Render: GET /register Helper
GET {{renderUrl}}/register
Accept: application/json
### 14. Production Render: GET /login Helper
GET {{renderUrl}}/login
Accept: application/json
### 15. Production Render: Login Verification
POST {{renderUrl}}/login
Content-Type: application/json

{
  "username": "israr_cloud",
  "password": "cloudPassword123"
}
### 16. Production Render: Invalid Password Rejection
POST {{renderUrl}}/login
Content-Type: application/json

{
  "username": "israr_cloud",
  "password": "wrongPassword"
}
### 17. Production Render: 404 Route Test
GET {{renderUrl}}/unmatched-path